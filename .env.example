# Sao chép thành .env.local — trên Vercel: Project → Settings → Environment Variables
#
# QUY TẮC: biến có tiền tố NEXT_PUBLIC_ bị nhúng vào JavaScript gửi cho trình duyệt => KHÔNG BAO GIỜ
# đặt secret vào biến NEXT_PUBLIC_*. Secret chỉ khai báo không có tiền tố (chỉ chạy phía server).

# ---- Public (an toàn để lộ ra trình duyệt) ----
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Base URL API (ưu tiên). Có thể dùng NEXT_PUBLIC_API_URL thay thế — cùng giá trị.
NEXT_PUBLIC_API_BASE_URL=https://pickleballshop-backend.fly.dev
# NEXT_PUBLIC_API_URL=https://pickleballshop-backend.fly.dev
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- Secret (CHỈ server; đặt trong Vercel Environment Variables, không commit) ----
# Dùng bởi app/api/upload/route.ts. Nếu từng bị lộ/chia sẻ => ROTATE trong Cloudinary Console.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (Tùy chọn) URL backend dùng phía server để xác thực token; mặc định lấy NEXT_PUBLIC_API_BASE_URL.
# API_BASE_URL=https://pickleballshop-backend.fly.dev

# ---- Debug (chỉ local) ----
# Chỉ có tác dụng khi NODE_ENV != production. KHÔNG đặt biến này trên Vercel production.
# NEXT_PUBLIC_DEBUG_API=true
